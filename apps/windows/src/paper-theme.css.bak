/*
 * Longform Studio IDE —— 星炉纸感主题
 * 色板来源：B 站 BV1L23z6eEak「星炉」实测（#FEFFFA / #F5F2EB / #DCD7CF / #4A4038 / #E9D5CF）
 */

:root {
  /* ---- 基础 ---- */
  --background: #FEFFFA;
  --bg: #FEFFFA;
  --bg-subtle: #F7F4ED;
  --surface: #F5F2EB;
  --surface-raised: #FFFFFF;
  --foreground: #4A4038;
  --text: #4A4038;
  --text-soft: #6B5D55;
  --text-muted: #7C6D67;
  --muted-foreground: #7C6D67;
  --muted: #7C6D67;
  --muted-bg: #F0ECE3;
  --border: #DCD7CF;
  --line: #DCD7CF;
  --line-strong: #C6BFB7;
  --nav-surface: #F5F2EB;
  --shadow: 0 18px 50px rgba(90, 75, 60, 0.12);

  --ink-100: #F7F4ED;
  --ink-200: #F0ECE3;
  --ink-300: #E4DFD5;
  --ink-400: #C6BFB7;
  --ink-500: #998F86;
  --ink-600: #7C6D67;
  --ink-700: #4A4038;

  --panel: #F5F2EB;
  --panel-strong: #F0ECE3;
  --panel-card-bg: #FFFFFF;
  --panel-note-bg: #F7F4ED;

  /* ---- 主色 / 强调 ---- */
  --primary: #6F6158;
  --primary-foreground: #FFFFFF;
  --secondary: #F0ECE3;
  --accent: #A98874;
  --accent-deep: #7C5C4C;
  --accent-rgb: 169, 136, 116;
  --accent-soft: rgba(169, 136, 116, 0.14);
  --accent-soft-strong: rgba(169, 136, 116, 0.24);
  --active: #A98874;

  --brand: #A98874;
  --brand-deep: #7C5C4C;
  --brand-rgb: 169, 136, 116;
  --brand-soft: rgba(169, 136, 116, 0.14);
  --brand-soft-strong: rgba(169, 136, 116, 0.24);
  --badge-bg: rgba(169, 136, 116, 0.14);
  --badge-border: rgba(169, 136, 116, 0.24);
  --badge-text: #7C5C4C;

  /* ---- 按钮 ---- */
  --btn-solid-bg: #6F6158;
  --btn-solid-border: #6F6158;
  --btn-solid-text: #FFFFFF;
  --btn-solid-shadow: 0 8px 20px rgba(90, 75, 60, 0.22);
  --btn-ghost-bg: rgba(111, 97, 88, 0.05);
  --btn-ghost-border: #DCD7CF;
  --btn-ghost-text: #4A4038;
  --btn-ghost-shadow: none;
  --btn-action-bg: rgba(254, 255, 250, 0.82);
  --btn-action-border: #DCD7CF;
  --btn-action-text: #4A4038;
  --btn-action-shadow: none;
  --btn-action-solid-bg: #6F6158;
  --btn-action-solid-border: #6F6158;
  --btn-action-solid-text: #FFFFFF;
  --btn-action-solid-shadow: 0 10px 24px rgba(90, 75, 60, 0.22);
  --btn-nav-bg: transparent;
  --btn-nav-border: transparent;
  --btn-nav-text: #4A4038;
  --btn-nav-hover-bg: rgba(111, 97, 88, 0.08);
  --btn-nav-hover-border: transparent;
  --btn-nav-shadow: none;
  --btn-nav-primary-bg: #6F6158;
  --btn-nav-primary-hover-bg: #5F534B;
  --btn-nav-primary-text: #FFFFFF;
  --btn-nav-primary-shadow: 0 10px 24px rgba(90, 75, 60, 0.22);
  --btn-danger-bg: rgba(168, 90, 77, 0.08);
  --btn-danger-border: rgba(168, 90, 77, 0.2);
  --btn-danger-text: #A85A4D;
  --btn-danger-solid-bg: #A85A4D;
  --btn-danger-solid-text: #FFFFFF;

  /* ---- 产品 ---- */
  --product-canvas: #FEFFFA;
  --product-surface: #F5F2EB;
  --product-surface-subtle: #F7F4ED;
  --product-text: #4A4038;
  --product-text-soft: #7C6D67;
  --product-muted: #7C6D67;
  --product-line: #DCD7CF;
  --product-line-strong: #C6BFB7;
  --product-primary: #6F6158;
  --product-primary-hover: #5F534B;
  --product-primary-soft: rgba(111, 97, 88, 0.12);
  --product-success: #7C8B6F;
  --product-warning: #B08A4F;
  --product-danger: #A85A4D;
  --product-shadow: 0 18px 50px rgba(90, 75, 60, 0.12);

  /* ---- 工作台 ---- */
  --wb-bg: #FEFFFA;
  --wb-panel: #F5F2EB;
  --wb-panel-strong: #F0ECE3;
  --wb-line: #DCD7CF;
  --wb-line-strong: #C6BFB7;
  --wb-text: #4A4038;
  --wb-muted: #7C6D67;
  --wb-signal: #A98874;
  --wb-gold: #B08A4F;
  --workbench-sidebar-lift: rgba(90, 75, 60, 0.12);

  /* ---- 影院（映射到纸感） ---- */
  --cinema-bg: #FEFFFA;
  --cinema-bg-soft: #F7F4ED;
  --cinema-panel: #F5F2EB;
  --cinema-panel-strong: #F0ECE3;
  --cinema-line: rgba(140, 125, 110, 0.16);
  --cinema-line-strong: rgba(140, 125, 110, 0.32);
  --cinema-text: #4A4038;
  --cinema-muted: #7C6D67;
  --cinema-signal: #A98874;
  --cinema-signal-soft: rgba(169, 136, 116, 0.12);
  --cinema-gold: #B08A4F;
  --cinema-danger: #A85A4D;
  --cinema-shadow: 0 18px 50px rgba(90, 75, 60, 0.12);

  /* ---- 状态 ---- */
  --status-success-bg: rgba(124, 139, 111, 0.14);
  --status-success-border: rgba(124, 139, 111, 0.32);
  --status-warning-bg: rgba(176, 138, 79, 0.14);
  --status-warning-border: rgba(176, 138, 79, 0.32);
  --status-error-bg: rgba(168, 90, 77, 0.12);
  --status-error-border: rgba(168, 90, 77, 0.3);
  --status-error-text: #A85A4D;
}

/* ---- 覆盖硬编码背景 ---- */
html,
body,
#root {
  background: #FEFFFA !important;
}

body {
  color: #4A4038 !important;
  background: #FEFFFA !important;
}

body::before {
  display: none !important;
}

body .al-nav {
  background: rgba(254, 255, 250, 0.92) !important;
  border-bottom: 1px solid #DCD7CF !important;
  box-shadow: 0 10px 30px rgba(90, 75, 60, 0.08) !important;
  backdrop-filter: blur(18px) saturate(120%);
}

body .al-nav-brand-name {
  color: #4A4038 !important;
}

body .al-nav-brand-code {
  color: #A98874 !important;
}

::selection {
  color: #4A4038 !important;
  background: rgba(169, 136, 116, 0.28) !important;
}

.workbench-app-shell {
  background: #FEFFFA !important;
}

body .workbench-app-shell .workbench-prose-paper,
body .workbench-app-shell .workbench-prose-preview {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
  box-shadow: 0 12px 34px rgba(90, 75, 60, 0.08) !important;
}

body .workbench-app-shell .workbench-prose-paper p,
body .workbench-app-shell .workbench-prose-paper textarea,
body .workbench-app-shell .workbench-prose-content {
  color: #4A4038 !important;
  background: #FFFFFF !important;
}

body .workbench-app-shell .workbench-prose-paper h1,
body .workbench-app-shell .workbench-prose-paper h2 {
  color: #4A4038 !important;
}

/* ---- 工作台左栏（product-ui 硬编码深色） ---- */
body .workbench-app-shell .workbench-triple-pane-left {
  background: #F5F2EB !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .workbench-worktop .wgb-title,
body .workbench-app-shell .workbench-worktop .workbench-global-title {
  color: #4A4038 !important;
}

/* ---- 工作台容器（cinematic-workbench 元素级深色变量） ---- */
html body .workbench-app-shell {
  --wb-bg: #FEFFFA;
  --wb-panel: #F5F2EB;
  --wb-panel-strong: #F0ECE3;
  --wb-line: rgba(140, 125, 110, 0.16);
  --wb-line-strong: rgba(140, 125, 110, 0.32);
  --wb-text: #4A4038;
  --wb-muted: #7C6D67;
  --wb-signal: #A98874;
  --wb-gold: #B08A4F;
  --bg: #FEFFFA;
  --bg-subtle: #F7F4ED;
  --text: #4A4038;
  --text-soft: #6B5D55;
  --muted: #7C6D67;
  --brand: #A98874;
  --brand-deep: #7C5C4C;
  --brand-soft: rgba(169, 136, 116, 0.14);
  --brand-soft-strong: rgba(169, 136, 116, 0.24);
  --accent: #B08A4F;
  --accent-deep: #8A6A4E;
  --accent-soft: rgba(176, 138, 79, 0.14);
  --surface: #F5F2EB;
  --panel: #F5F2EB;
  --panel-strong: #F0ECE3;
  --panel-note-bg: #F7F4ED;
  --line: #DCD7CF;
  --line-strong: #C6BFB7;
  color: #4A4038 !important;
  background: #FEFFFA !important;
}

/* 顶部导航（工作台场景兜底） */
html body .al-nav {
  background: rgba(254, 255, 250, 0.92) !important;
  border-bottom: 1px solid #DCD7CF !important;
  box-shadow: 0 10px 30px rgba(90, 75, 60, 0.08) !important;
}

/* ---- 覆盖 product-ui "Final dark contrast layer"（同选择器、后注入） ---- */
body .workbench-stage.workbench-app-shell,
body .workbench-app-shell .workbench-worktop,
body .workbench-app-shell .workbench-triple-pane {
  border-color: #DCD7CF !important;
  background: #FEFFFA !important;
}

body .workbench-app-shell .workbench-worktop {
  background: rgba(254, 255, 250, 0.96) !important;
}

body .workbench-app-shell .workbench-triple-pane-left {
  border-color: #DCD7CF !important;
  background: #F5F2EB !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .workbench-triple-pane-center {
  background: #FEFFFA !important;
}

body .workbench-app-shell .workbench-triple-pane-right {
  border-color: #DCD7CF !important;
  background: #F0ECE3 !important;
}

body .workbench-app-shell .workbench-nav-section-head,
body .workbench-app-shell .workbench-nav-select-label,
body .workbench-app-shell .workbench-nav-field > span,
body .workbench-app-shell .workbench-nav-volume-title {
  color: #7C6D67 !important;
}

body .workbench-app-shell .workbench-nav-link {
  color: #4A4038 !important;
  background: transparent !important;
}

body .workbench-app-shell .workbench-nav-link:hover:not(:disabled),
body .workbench-app-shell .workbench-nav-link.is-active {
  color: #4A4038 !important;
  background: rgba(169, 136, 116, 0.14) !important;
}

body .workbench-app-shell .workbench-entry-mode-trigger,
body .workbench-app-shell .workbench-nav-select-trigger,
body .workbench-app-shell .workbench-nav-chapter-switch button,
body .workbench-app-shell .workbench-nav-field select,
body .workbench-app-shell .workbench-nav-field input {
  border-color: #C6BFB7 !important;
  background: #FFFFFF !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .workbench-entry-mode-trigger:hover,
body .workbench-app-shell .workbench-nav-select-trigger:hover,
body .workbench-app-shell .workbench-nav-select-trigger.is-open {
  border-color: rgba(169, 136, 116, 0.5) !important;
  background: rgba(169, 136, 116, 0.1) !important;
}

body .workbench-app-shell .workbench-entry-mode-trigger span,
body .workbench-app-shell .workbench-nav-select-trigger em {
  color: #7C6D67 !important;
}

body .workbench-app-shell .workbench-entry-mode-trigger strong,
body .workbench-app-shell .workbench-nav-select-trigger strong {
  color: #4A4038 !important;
}

body .workbench-app-shell .workbench-nav-select-menu,
body .workbench-app-shell .workbench-entry-mode-menu {
  border-color: #C6BFB7 !important;
  background: #FFFFFF !important;
}

body .workbench-app-shell .workbench-nav-select-option,
body .workbench-app-shell .workbench-entry-mode-menu button {
  color: #4A4038 !important;
}

body .workbench-app-shell .workbench-nav-select-option:hover,
body .workbench-app-shell .workbench-nav-select-option.is-active,
body .workbench-app-shell .workbench-entry-mode-menu button:hover {
  color: #4A4038 !important;
  background: rgba(169, 136, 116, 0.12) !important;
}

body .workbench-app-shell .workbench-generation-prep-row.is-blocked {
  border-color: rgba(168, 90, 77, 0.4) !important;
  background: rgba(168, 90, 77, 0.08) !important;
}

body .workbench-app-shell .workbench-generation-prep-row.is-ready {
  border-color: rgba(124, 139, 111, 0.34) !important;
  background: rgba(124, 139, 111, 0.12) !important;
}

body .workbench-app-shell .wpa-secondary,
body .workbench-app-shell .gen-settings-trigger,
body .workbench-app-shell .workbench-info-card-edit {
  border-color: #C6BFB7 !important;
  background: rgba(111, 97, 88, 0.06) !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .wpa-secondary:hover,
body .workbench-app-shell .gen-settings-trigger:hover,
body .workbench-app-shell .workbench-info-card-edit:hover {
  border-color: rgba(169, 136, 116, 0.5) !important;
  background: rgba(169, 136, 116, 0.12) !important;
  color: #7C5C4C !important;
}

body .workbench-app-shell .wpa-generate,
body .workbench-app-shell .workbench-prose-actions .primary-btn,
body .workbench-app-shell .workbench-meta-actions .primary-btn,
body .workbench-app-shell .workbench-generation-preview > button {
  border-color: #6F6158 !important;
  background: #6F6158 !important;
  color: #FFFFFF !important;
}

body .workbench-app-shell .workbench-info-card {
  border-color: #DCD7CF !important;
  background: #FFFFFF !important;
}

body .workbench-app-shell .workbench-info-card-title {
  border-color: #DCD7CF !important;
  background: #F5F2EB !important;
  color: #7C5C4C !important;
}

body .workbench-app-shell .workbench-info-row,
body .workbench-app-shell .workbench-info-character {
  border-color: #DCD7CF !important;
  background: #F7F4ED !important;
}

body .workbench-app-shell .gen-settings-panel {
  border-color: #C6BFB7 !important;
  background: #FFFFFF !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .gen-settings-panel-head,
body .workbench-app-shell .gen-settings-option,
body .workbench-app-shell .gen-settings-toggle,
body .workbench-app-shell .gen-settings-input,
body .workbench-app-shell .gen-settings-textarea {
  border-color: #DCD7CF !important;
  background: #FFFFFF !important;
  color: #4A4038 !important;
}

body .workbench-app-shell .gen-settings-option:hover,
body .workbench-app-shell .gen-settings-option.is-active {
  border-color: rgba(169, 136, 116, 0.5) !important;
  background: rgba(169, 136, 116, 0.12) !important;
}

body .workbench-app-shell .workbench-surface-tabs {
  background: #F0ECE3 !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .workbench-surface-tab {
  color: #7C6D67 !important;
}

body .workbench-app-shell .workbench-surface-tab.is-active {
  background: #FFFFFF !important;
  color: #4A4038 !important;
  border-color: #C6BFB7 !important;
}

body .workbench-app-shell .workbench-sidebar-shell {
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .workbench-section,
body .workbench-app-shell .workbench-content-meta .workbench-section,
body .workbench-app-shell .workbench-prose-main .workbench-section {
  background: #FEFFFA !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .workbench-generation-preview {
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .workbench-generation-prep-row {
  background: #F7F4ED !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .workbench-generation-prep-row.is-warning,
body .workbench-app-shell .workbench-generation-prep-row.is-storyline.is-warning {
  background: rgba(168, 90, 77, 0.08) !important;
  border-color: rgba(168, 90, 77, 0.3) !important;
}

body .workbench-app-shell .blind-label-panel {
  background: rgba(254, 255, 250, 0.82) !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell select,
body .workbench-app-shell input,
body .workbench-app-shell textarea {
  background: #FFFFFF !important;
  border-color: #C6BFB7 !important;
  color: #4A4038 !important;
}

/* ---- 顶部导航切换器（所有页面） ---- */
html body .al-nav-switcher {
  background: #F0ECE3 !important;
  border-color: #DCD7CF !important;
  box-shadow: none !important;
}

html body .al-nav-switcher-option {
  color: #7C6D67 !important;
  background: transparent !important;
}

html body .al-nav-switcher-option:hover {
  color: #4A4038 !important;
  background: rgba(111, 97, 88, 0.08) !important;
  transform: none !important;
}

html body .al-nav-switcher-option.is-active {
  color: #FFFFFF !important;
  background: #6F6158 !important;
  box-shadow: 0 4px 12px rgba(90, 75, 60, 0.18) !important;
}

html body .al-nav-switcher-option.is-active:hover {
  color: #FFFFFF !important;
  background: #5F534B !important;
}

/* ---- 资料库页面（books-admin-page） ---- */
body .books-admin-page .library-sidebar {
  background: #F5F2EB !important;
  border-right: 1px solid #DCD7CF !important;
  box-shadow: none !important;
}

body .books-admin-page .library-sidebar-head,
body .books-admin-page .library-sidebar-section {
  border-color: #DCD7CF !important;
}

body .books-admin-page .library-nav-item {
  color: #4A4038 !important;
  background: transparent !important;
}

html body .books-admin-page :is(.books-page-prompt-entry, .books-page-toolbar-input, .books-page-toolbar-select, .books-page-toolbar-btn) {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #C6BFB7 !important;
  box-shadow: none !important;
}

html body .books-admin-page :is(.books-page-prompt-entry, .books-page-toolbar-btn):hover:not(:disabled) {
  color: #7C5C4C !important;
  background: rgba(169, 136, 116, 0.1) !important;
  border-color: rgba(169, 136, 116, 0.4) !important;
}

html body .books-admin-page .books-page-toolbar-btn-primary {
  color: #FFFFFF !important;
  background: #6F6158 !important;
  border-color: #6F6158 !important;
  box-shadow: 0 8px 20px rgba(90, 75, 60, 0.2) !important;
}

html body .books-admin-page .books-page-toolbar-btn-primary:hover:not(:disabled) {
  color: #FFFFFF !important;
  background: #5F534B !important;
  border-color: #5F534B !important;
}

body .books-admin-page .detail-inline-count-input {
  background: #FFFFFF !important;
  border-color: #C6BFB7 !important;
  color: #4A4038 !important;
}

html body .books-admin-page :is(input, textarea, select) {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #C6BFB7 !important;
}

html body .books-admin-page .detail-outline-section .detail-inline-editor {
  background: #F0ECE3 !important;
  border: 1px solid rgba(140, 125, 110, 0.28) !important;
  padding: 14px !important;
}

html body .books-admin-page .detail-outline-section .detail-inline-editor textarea {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #C6BFB7 !important;
}

/* ---- 更新日志 ---- */
html body .page-shell:has(.changelog-page-title) .changelog-page-meta {
  color: #7C6D67 !important;
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

html body .page-shell:has(.changelog-page-title) .changelog-page-card {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

/* ---- 提示词管理弹窗 ---- */
body .workbench-app-shell .prompt-manager-modal-backdrop {
  background: rgba(90, 75, 60, 0.32) !important;
}

body .workbench-app-shell .prompt-manager-modal-panel {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
  box-shadow: 0 24px 70px rgba(90, 75, 60, 0.18) !important;
}

body .workbench-app-shell .prompt-manager-header,
body .workbench-app-shell .prompt-manager-card {
  color: #4A4038 !important;
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .prompt-manager-card.is-error,
body .workbench-app-shell .prompt-manager-card.is-empty {
  background: #FDF6F4 !important;
  border-color: rgba(168, 90, 77, 0.3) !important;
}

body .workbench-app-shell .prompt-manager-pre {
  color: #4A4038 !important;
  background: #F7F4ED !important;
  border: 1px solid #DCD7CF !important;
}

body .workbench-app-shell .prompt-manager-empty {
  background: #F7F4ED !important;
  border-color: #DCD7CF !important;
}

body .workbench-app-shell .prompt-manager-meta span {
  color: #7C5C4C !important;
  background: rgba(169, 136, 116, 0.1) !important;
  border-color: rgba(169, 136, 116, 0.22) !important;
}

/* ---- 首页特性卡片（渐变深色） ---- */
html body .hp-feature-card {
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

/* ---- 资料库统计卡 / 工具栏 / 书籍卡（渐变深色） ---- */
html body .books-admin-page .books-page-stat-card,
html body .books-admin-page .books-page-stat-card:first-child {
  color: #4A4038 !important;
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .books-page-toolbar {
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .books-page-card {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

/* ---- 大纲 / 详情面板（渐变深色） ---- */
html body .books-admin-page .detail-panel {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #E4DFD5 !important;
  border-radius: 16px !important;
  padding: 18px !important;
  box-shadow: 0 10px 26px rgba(90, 75, 60, 0.08) !important;
}

html body .books-admin-page .detail-outline-section {
  color: #4A4038 !important;
  background: #F7F4ED !important;
  border: 1px solid rgba(140, 125, 110, 0.28) !important;
  border-radius: 12px !important;
  padding: 16px 18px !important;
  box-shadow: none !important;
}

html body .books-admin-page .detail-section {
  color: #4A4038 !important;
  background: #F7F4ED !important;
  border: 1px solid rgba(140, 125, 110, 0.28) !important;
  border-radius: 12px !important;
  padding: 16px 18px !important;
  box-shadow: none !important;
}

/* 卡片风格统一（浅阴影，弱化框线感） */
html body .books-admin-page .storyline-board-card,
html body .books-admin-page .chapter-flow-card,
html body .books-admin-page .summary-nav-card,
html body .books-admin-page .books-page-card {
  box-shadow: 0 8px 20px rgba(90, 75, 60, 0.06) !important;
  border-color: #E4DFD5 !important;
}

html body .books-admin-page .storyline-board-card {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .chapter-flow-board {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .chapter-flow-card {
  color: #4A4038 !important;
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .ghost-btn {
  color: #4A4038 !important;
  background: rgba(111, 97, 88, 0.05) !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .chapter-flow-card .chapter-flow-actions .ghost-btn {
  color: #4A4038 !important;
  background: rgba(111, 97, 88, 0.05) !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .chapter-flow-card .chapter-flow-actions .ghost-btn:hover:not(:disabled) {
  color: #7C5C4C !important;
  background: rgba(169, 136, 116, 0.12) !important;
  border-color: rgba(169, 136, 116, 0.4) !important;
}

/* ---- 全书汇总（书籍详情） ---- */
html body .books-admin-page .summary-metric-card {
  color: #4A4038 !important;
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
}

html body .books-admin-page .summary-nav-card {
  color: #4A4038 !important;
  background: #FFFFFF !important;
  border-color: #DCD7CF !important;
}

/* ---- 首页 hero 图形（HomePage 内嵌 style 深色） ---- */
html body .hp-hero-visual {
  background:
    linear-gradient(135deg, rgba(169, 136, 116, 0.06), transparent 42%),
    linear-gradient(315deg, rgba(176, 138, 79, 0.06), transparent 38%),
    #F0ECE3 !important;
  border-color: #DCD7CF !important;
}

html body .hp-hero-visual::before {
  background-image:
    linear-gradient(rgba(124, 109, 96, 0.1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(124, 109, 96, 0.1) 1px, transparent 1px) !important;
}

html body .hp-hero-visual-topline,
html body .hp-hero-visual-footer {
  color: #7C6D67 !important;
}

html body .hp-hero-visual-live {
  color: #A98874 !important;
}

html body .hp-hero-visual-live::before {
  background: #A98874 !important;
  box-shadow: 0 0 0 4px rgba(169, 136, 116, 0.12), 0 0 12px rgba(169, 136, 116, 0.5) !important;
}

html body .hp-hero-visual-lines path {
  stroke: rgba(169, 136, 116, 0.38) !important;
}

html body .hp-hero-visual-lines path:nth-child(3n) {
  stroke: rgba(176, 138, 79, 0.45) !important;
}

html body .hp-hero-visual-lines circle {
  fill: #F5F2EB !important;
  stroke: #A98874 !important;
}

html body .hp-hero-visual-lines circle:nth-of-type(2n) {
  stroke: #B08A4F !important;
}

html body .hp-hero-visual-core {
  border-color: rgba(169, 136, 116, 0.5) !important;
  background: rgba(255, 255, 255, 0.55) !important;
}

html body .hp-hero-visual-core::before,
html body .hp-hero-visual-core::after {
  border-color: #B08A4F !important;
}

html body .hp-hero-visual-core-label {
  color: #7C5C4C !important;
}

html body .hp-story-node {
  background: #F5F2EB !important;
  border-color: #DCD7CF !important;
  color: #4A4038 !important;
}

html body .hp-story-node small {
  color: #7C6D67 !important;
}
