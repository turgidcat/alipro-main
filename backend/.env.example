# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：审计与修稿可以使用不同模型，减少正文模型自评偏差；留空则沿用正文模型
DEEPSEEK_JUDGE_MODEL=
DEEPSEEK_REPAIR_MODEL=
# 单次流式请求硬时限（毫秒），防止心跳让请求无限挂起
DEEPSEEK_STREAM_HARD_TIMEOUT_MS=240000
# 正文字数修订次数，建议 1-7，默认 2
WORD_COUNT_REVISION_MAX_ATTEMPTS=3

# 阿里云百炼 API 配置（可选，用于创意命名任务）
# 注册地址：https://bailian.console.aliyun.com/
# 使用模型：qwen-max（创意能力最强）
# 免费额度：新用户赠送一定额度的免费调用次数
ALIYUN_BAILIAN_API_KEY=your_aliyun_bailian_api_key_here

# 服务器配置
PORT=3000
NODE_ENV=development

# Edge TTS 有声书（可选，默认使用 backend/tts-venv 中的 Python 环境）
# ALIPRO_TTS_PYTHON=python
# ALIPRO_TTS_DIR=C:\path\to\audio\output
