# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
# 可选：审计与修稿可以使用不同模型，减少正文模型自评偏差；留空则沿用正文模型
DEEPSEEK_JUDGE_MODEL=
DEEPSEEK_REPAIR_MODEL=
# 单次流式请求硬时限（毫秒），防止心跳让请求无限挂起
DEEPSEEK_STREAM_HARD_TIMEOUT_MS=240000
# 正文字数修订次数，建议 1-7，默认 2
WORD_COUNT_REVISION_MAX_ATTEMPTS=3

# 阿里云百炼 API 配置（可选，用于创意命名任务）
# 注册地址：https://bailian.console.aliyun.com/
# 使用模型：qwen-max（创意能力最强）
# 免费额度：新用户赠送一定额度的免费调用次数
ALIYUN_BAILIAN_API_KEY=your_aliyun_bailian_api_key_here

# 服务器配置
PORT=3000
NODE_ENV=development

# 用户系统（生产环境必须替换为随机长字符串，至少 32 位）
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d
SMS_CODE_SECRET=replace_with_another_random_secret
AUDIO_TICKET_SECRET=replace_with_another_random_secret
ALLOW_ANONYMOUS_DATA=true
PUBLIC_APP_URL=https://turgidcat.space/projects/alipro
PUBLIC_API_URL=https://turgidcat.space/projects/alipro/api
DATA_REGION=aliyun-ecs

# 阿里云号码认证服务 / 短信认证（个人开发者免资质）
# ECS 部署推荐 ecs_ram_role；本地开发可用 access_key
ALIYUN_PNVS_CREDENTIAL_MODE=ecs_ram_role
ALIYUN_PNVS_ECS_RAM_ROLE_NAME=
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
# 控制台“短信认证参数配置”中的当前系统赠送签名名称
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_SCHEME_NAME=alipro
ALIYUN_PNVS_REGION_ID=cn-hangzhou
# 防盗刷默认值：单号码 60 秒/5 次每小时/10 次每日；全站每日最多 500 条
SMS_MIN_INTERVAL_SECONDS=60
SMS_PHONE_HOURLY_LIMIT=5
SMS_PHONE_DAILY_LIMIT=10
SMS_IP_TEN_MINUTE_LIMIT=10
SMS_IP_HOURLY_LIMIT=30
SMS_IP_DAILY_LIMIT=100
SMS_GLOBAL_DAILY_LIMIT=500

# QQ 互联 / 微信开放平台
QQ_APP_ID=
QQ_APP_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Edge TTS 有声书（可选，默认使用 backend/tts-venv 中的 Python 环境）
# ALIPRO_TTS_PYTHON=python
# ALIPRO_TTS_DIR=C:\path\to\audio\output

# 模型调用观察台（非生产默认采集，生产默认关闭；仅保存请求体/响应，不保存密钥请求头）
# ALIPRO_AI_MONITOR=1
# ALIPRO_AI_MONITOR_DIR=C:\Users\your-name\AppData\Local\ALIPRO\model-monitor
