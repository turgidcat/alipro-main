    "dev:backend": "npm --prefix backend run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:android": "npm --prefix apps/android run build:debug",
    "build:windows": "npm --prefix apps/windows run package:win",
    "verify:frontend": "npm --prefix apps/web run verify:frontend-contracts"
  }
